# ─────────────────────────────────────────────────────────────
# Velnix environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — it is gitignored.
# ─────────────────────────────────────────────────────────────

# AniList (metadata API). AniList's public GraphQL endpoint is free and does
# NOT require an API key for read-only metadata. If you need higher rate
# limits, register a client at https://anilist.co/settings/developer and set
# a token here (optional).
ANILIST_ENDPOINT="https://graphql.anilist.co"
ANILIST_TOKEN=""

# Provider enable flags (0 = disabled, 1 = enabled). Only providers you have
# legal access to should be enabled. Disabled providers are skipped by the
# Provider Router.
VELNIX_PROVIDER_DEMO="1"
VELNIX_PROVIDER_SAMPLE="0"

# ---- LEGITIMATE PROVIDER CONFIG (fill in when you have access) ----
# Each authorized provider exposes its own credentials here. Leaving these
# blank keeps the provider disabled so the resolver never attempts a request
# it is not authorized to make.
# Example (illustrative):
# PROVIDER_CRUNCHYROLL_CLIENT_ID=""
# PROVIDER_CRUNCHYROLL_CLIENT_SECRET=""
# PROVIDER_CRUNCHYROLL_TOKEN=""

# Resolver behavior
VELNIX_RESOLVER_TIMEOUT_MS="8000"
VELNIX_RESOLVER_MAX_ATTEMPTS="3"

# Public base URL of the app (used for metadata/canonical links)
VELNIX_PUBLIC_URL="http://localhost:3000"
